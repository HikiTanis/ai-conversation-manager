                                                            <TextBlock Text="{Binding DisplayMetadata}" Foreground="{StaticResource Muted}" FontSize="10.8" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayMetadata}" />
