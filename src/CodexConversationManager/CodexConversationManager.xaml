            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemSurface" Padding="13,11" CornerRadius="11" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="#F1F2EE" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="{StaticResource AccentSoft}" />
                                <Setter TargetName="ItemSurface" Property="BorderBrush" Value="#CDEBE1" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsBatchSelected}" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="#DCF2EA" />
                                <Setter TargetName="ItemSurface" Property="BorderBrush" Value="#9FD9C6" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

