{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Conversation Manager",
  "version": "2.1.0",
  "identifier": "io.github.hikitanis.aiconversationmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI 对话管理器 · Codex / DSH",
        "width": 1260,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "resources": { "engine/": "engine/" },
    "icon": ["icons/app-icon.ico"]
  }
}
